# Copy to .env.local and fill in from your Supabase project:
#   Dashboard -> Project Settings -> Data API  (URL)
#   Dashboard -> Project Settings -> API Keys  (anon / publishable key)
#
# Both values are compiled into the published bundle and are safe to expose;
# access is governed by the row-level security policies in supabase/schema.sql.
# Vite only reads these at build time, so re-run `npm run deploy` after changing them.

# The URL is the bare project origin — do NOT append /rest/v1, the client adds it.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
